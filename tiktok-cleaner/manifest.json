{
  "manifest_version": 3,
  "name": "TikTok Cleaner",
  "version": "2.0.0",
  "description": "Bulk unlike TikTok liked videos using the normal TikTok interface.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://www.tiktok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Cleaner"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
